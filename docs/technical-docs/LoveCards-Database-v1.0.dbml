// =============================================================================
// Love Cards Platform — Database Schema (DBML)
// Phiên bản: 1.0 | PostgreSQL 16.x
// Tham chiếu: LoveCards-DomainModel-v1.0.md, LoveCards-FunctionalDesign-v1.0.md,
//             db-decisions.md, db-design-plan.md
// =============================================================================
//
// TỔNG QUAN
// ---------
// - 8 schema theo Bounded Context, 17 bảng
// - Quy ước: snake_case, PK uuid, tiền bigint (VND), timestamp UTC
// - Soft delete (deleted_at): users, templates, orders, cards
// - Audit: created_at, updated_at, created_by, updated_by (hầu hết bảng admin/catalog)
//
// LUỒNG NGHIỆP VỤ CHÍNH
// --------------------
// User đăng ký/đăng nhập → duyệt catalog.templates → thêm commerce.cart_items
// → tạo commerce.orders + order_items → thanh toán → tạo cards.cards
// → khách gửi engagement.rsvps / wishes → ghi analytics
//
// SCHEMA → BẢNG (tra cứu nhanh)
// ------------------------------
// auth       : users
// catalog    : templates, template_fields, music_library
// commerce   : cart_items, hosting_plans, orders, order_items, order_status_history
// cards      : cards, card_fields, card_media, bank_accounts
// engagement : rsvps, wishes
// analytics  : card_analytics_raw, card_analytics_daily
// marketing  : newsletter_subscribers, b2b_contacts
// admin      : audit_logs
//
// NGOÀI DB (Redis): JWT, OTP, verify token, session — không có bảng tương ứng
// =============================================================================

// =============================================================================
// ENUMS — Các giá trị cố định (Value Objects)
// =============================================================================

// Nhà cung cấp đăng nhập
Enum auth.auth_provider {
  local      // Email/SĐT + mật khẩu
  google     // OAuth Google
  facebook   // OAuth Facebook
}

// Vai trò hệ thống
Enum auth.user_role {
  user       // Khách hàng (KVL)
  admin      // Quản trị viên
}

// Trạng thái tài khoản
Enum auth.user_status {
  active     // Đang hoạt động
  blocked    // Bị khóa bởi admin
  pending    // Chờ xác thực email/SĐT
}

Enum auth.language {
  vi
  en
}

// Loại sự kiện của mẫu thiệp
Enum catalog.event_type {
  wedding    // Cưới
  birthday   // Sinh nhật
  party      // Tiệc
  other      // Khác
}

Enum catalog.template_status {
  active     // Hiển thị trên catalog, có thể mua
  inactive   // Ẩn, không bán
}

// Kiểu trường động trên form tùy chỉnh thiệp
Enum catalog.field_type {
  text
  date
  time
  textarea
  image
}

Enum catalog.music_genre {
  romantic
  cheerful
  classical
  acoustic
}

// State machine đơn hàng (Functional Design §4)
Enum commerce.order_status {
  created          // Vừa tạo
  pending_qr       // Chờ thanh toán QR ngân hàng
  pending_ewallet  // Chờ ví Momo/ZaloPay/VNPay
  pending_card     // Chờ thẻ Visa
  verifying        // Admin/gateway đang xác minh
  paid             // Đã thanh toán — đơn bất biến (COM-09)
  completed        // Hoàn tất (đã tạo thiệp)
  failed           // Thanh toán thất bại
  expired          // Hết hạn chờ thanh toán
  cancelled        // Đã hủy
}

Enum commerce.payment_method {
  qr_bank    // Chuyển khoản / QR ngân hàng
  momo
  zalopay
  vnpay
  visa
}

Enum commerce.payment_status {
  pending
  processing
  success
  failed
}

Enum cards.card_status {
  draft      // Đang chỉnh sửa
  published  // Đã xuất bản — URL công khai hoạt động
  expired    // Hết hạn gói hosting
}

Enum cards.media_type {
  image
  music
}

Enum analytics.device_type {
  mobile
  tablet
  desktop
}

Enum analytics.traffic_source {
  zalo
  facebook
  messenger
  sms
  direct
  other
}

Enum marketing.contact_status {
  new        // Lead mới
  contacted  // Đã liên hệ
  closed     // Đã xử lý xong
}

Enum admin.audit_action {
  create
  update
  delete
  status_change
  login
  block_user
  confirm_payment
}


// =============================================================================
// SCHEMA: auth — Identity & Access (Đăng ký, đăng nhập, phân quyền | EPIC 4)
// =============================================================================

Table auth.users {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Định danh duy nhất']
  email varchar(320) [unique, note: 'Email RFC 5321; null nếu đăng ký bằng SĐT']
  phone varchar(15) [unique, note: 'SĐT VN E.164; null nếu đăng ký bằng email']
  password_hash text [note: 'BCrypt cost 12; null nếu OAuth']
  full_name varchar(100) [not null, note: 'Họ tên đầy đủ (2–100 ký tự)']
  avatar_url text [note: 'URL ảnh đại diện']
  auth_provider auth.auth_provider [not null, default: 'local', note: 'Kênh đăng nhập']
  provider_id varchar(255) [note: 'ID user từ Google/Facebook']
  role auth.user_role [not null, default: 'user', note: 'user | admin']
  status auth.user_status [not null, default: 'pending', note: 'active sau xác thực']
  email_verified boolean [default: false, note: 'Email đã xác thực']
  phone_verified boolean [default: false, note: 'SĐT đã xác thực OTP']
  language auth.language [default: 'vi', note: 'Ngôn ngữ giao diện']
  metadata jsonb [default: '{}', note: 'Cấu hình mở rộng (preferences)']
  deleted_at timestamp [note: 'Soft delete — không xóa vật lý']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid [note: 'UUID người tạo (self-ref hoặc system)']
  updated_by uuid [note: 'UUID người sửa cuối']

  Note: '''
  [AR] Người dùng — Aggregate Root (Identity & Access).
  Ràng buộc: email HOẶC phone phải có giá trị (CHECK IAR-01).
  Unique email/phone chỉ áp dụng khi deleted_at IS NULL (partial unique).
  Liên kết: cart_items, orders, cards (user_id); audit_logs (actor_id).
  '''
}

// =============================================================================
// SCHEMA: catalog — Catalog & Discovery (Mẫu thiệp, nhạc | EPIC 1, 2)
// =============================================================================

Table catalog.templates {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(200) [not null, note: 'Tên mẫu thiệp hiển thị']
  slug varchar(200) [unique, not null, note: 'URL-friendly, chữ thường, không dấu']
  description text [note: 'Mô tả chi tiết mẫu']
  event_type catalog.event_type [not null, note: 'Loại sự kiện: cưới, sinh nhật...']
  color_tags jsonb [default: '[]', note: 'Màu lọc catalog, VD: ["pink","gold"]']
  price bigint [not null, note: 'Giá VND, phải > 0 (CAT-03)']
  status catalog.template_status [not null, default: 'inactive']
  preview_url text [not null, note: 'URL S3 file HTML preview']
  thumbnail_url text [note: 'Ảnh thumbnail catalog']
  assets_path text [note: 'Đường dẫn thư mục asset trên S3']
  has_music boolean [default: false, note: 'Mẫu có hỗ trợ nhạc nền']
  is_featured boolean [default: false, note: 'Hiển thị section nổi bật homepage']
  is_trending boolean [default: false, note: 'Hiển thị section trending']
  view_count bigint [default: 0, note: 'Lượt xem trên catalog']
  purchase_count bigint [default: 0, note: 'Số lần đã mua']
  metadata jsonb [default: '{}', note: 'Cấu hình style, setting mở rộng']
  deleted_at timestamp [note: 'Soft delete']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  updated_by uuid

  Note: '''
  [AR] Mẫu thiệp — Aggregate Root (Catalog & Discovery).
  Không hard-delete nếu đã có đơn hàng (CAT-04).
  Quan hệ 1-N: template_fields. Được tham chiếu bởi cart_items, order_items, cards.
  '''
}

Table catalog.template_fields {
  id uuid [pk, default: `gen_random_uuid()`]
  template_id uuid [not null, ref: > catalog.templates.id, note: 'FK mẫu thiệp']
  field_key varchar(100) [not null, note: 'Key kỹ thuật: bride_name, event_date...']
  field_label varchar(200) [not null, note: 'Nhãn hiển thị trên form']
  field_type catalog.field_type [not null, note: 'text | date | time | textarea | image']
  placeholder varchar(200) [note: 'Gợi ý nhập liệu']
  is_required boolean [default: false, note: 'Bắt buộc nhập hay không']
  max_length integer [note: 'Giới hạn ký tự (text/textarea)']
  display_order integer [not null, default: 0, note: 'Thứ tự hiển thị trên form']
  validation jsonb [default: '{}', note: 'Quy tắc mở rộng: regex, min, max']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  updated_by uuid

  Note: '''
  [E] Trường động của mẫu — thuộc Template Aggregate.
  Unique (template_id, display_order). Mỗi mẫu định nghĩa form tùy chỉnh riêng.
  Giá trị người dùng nhập lưu tại cards.card_fields.
  '''
}

Table catalog.music_library {
  id uuid [pk, default: `gen_random_uuid()`]
  title varchar(200) [not null, note: 'Tên bài nhạc']
  genre catalog.music_genre [note: 'Thể loại nhạc nền']
  duration_sec integer [note: 'Thời lượng (giây)']
  file_url text [not null, note: 'URL file nhạc trên S3']
  is_active boolean [default: true, note: 'Chỉ track bản royalty-free đang dùng']
  metadata jsonb [default: '{}', note: 'artist, bpm, mood tags']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  updated_by uuid

  Note: '''
  [AR] Thư viện nhạc nền — Aggregate Root.
  Chỉ bản quyền miễn phí. Tham chiếu từ cards.cards (music_id).
  '''
}

// =============================================================================
// SCHEMA: commerce — Commerce (Giỏ, đơn, thanh toán, hosting | EPIC 3, 6)
// =============================================================================

Table commerce.cart_items {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > auth.users.id, note: 'Chủ giỏ hàng']
  template_id uuid [not null, ref: > catalog.templates.id, note: 'Mẫu trong giỏ']
  added_at timestamp [not null, default: `now()`, note: 'Thời điểm thêm vào giỏ']

  indexes {
    (user_id, template_id) [unique, note: 'COM-01: Mỗi mẫu chỉ 1 dòng trong giỏ']
  }

  Note: '''
  [E] Mục giỏ hàng — thuộc Cart Aggregate.
  Xóa cứng khi user remove. Merge giỏ cookie khi đăng nhập (Functional Design).
  '''
}

Table commerce.hosting_plans {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100) [not null, note: 'Tên gói, VD: 6 tháng, 12 tháng']
  duration_months integer [not null, note: 'Thời hạn lưu thiệp (tháng)']
  price bigint [not null, note: 'Giá gói VND']
  description text [note: 'Mô tả gói']
  features jsonb [default: '[]', note: 'Tính năng: ["RSVP","Analytics","Custom OG"]']
  is_recommended boolean [default: false, note: 'Gợi ý trên UI checkout']
  is_active boolean [default: true, note: 'Chỉ plan active được chọn (COM-10)']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  updated_by uuid

  Note: '''
  [AR] Gói lưu trữ thiệp — thời hạn hosting sau khi mua.
  Liên kết order_items.hosting_plan_id. Quyết định expires_at trên cards.cards.
  '''
}

Table commerce.orders {
  id uuid [pk, default: `gen_random_uuid()`]
  order_code varchar(20) [unique, not null, note: 'Mã đơn: LC-YYYYMMDD-XXXX']
  user_id uuid [not null, ref: > auth.users.id, note: 'Người đặt hàng']
  total_amount bigint [not null, note: 'Tổng VND = template_price + hosting_price']
  payment_method commerce.payment_method [note: 'Phương thức thanh toán']
  payment_status commerce.payment_status [not null, default: 'pending', note: 'Trạng thái cổng thanh toán']
  payment_ref varchar(255) [note: 'Mã giao dịch từ gateway']
  payment_data jsonb [default: '{}', note: 'Response gateway, số lần thử, metadata']
  status commerce.order_status [not null, default: 'created', note: 'State machine đơn hàng']
  paid_at timestamp [note: 'Thời điểm xác nhận thanh toán']
  deleted_at timestamp [note: 'Soft delete']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  updated_by uuid

  Note: '''
  [AR] Đơn hàng — Aggregate Root (Commerce).
  Sau trạng thái paid: dữ liệu đơn bất biến (COM-09).
  Event OrderPaid → tạo cards.cards. Lịch sử trạng thái: order_status_history.
  '''
}

Table commerce.order_items {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null, ref: > commerce.orders.id, note: 'FK đơn hàng']
  template_id uuid [not null, ref: > catalog.templates.id, note: 'Mẫu đã mua']
  hosting_plan_id uuid [ref: > commerce.hosting_plans.id, note: 'Gói hosting (nullable)']
  template_price bigint [not null, note: 'Snapshot giá mẫu lúc mua — không đổi']
  hosting_price bigint [not null, default: 0, note: 'Snapshot giá hosting lúc mua']
  created_at timestamp [not null, default: `now()`]

  Note: '''
  [E] Dòng chi tiết đơn — thuộc Order Aggregate.
  Giá snapshot bất biến. 1 order_item có thể sinh 1 cards.cards (order_item_id).
  '''
}

Table commerce.order_status_history {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null, ref: > commerce.orders.id, note: 'FK đơn hàng']
  from_status commerce.order_status [note: 'Trạng thái trước (null nếu lần đầu)']
  to_status commerce.order_status [not null, note: 'Trạng thái sau chuyển']
  reason text [note: 'Lý do chuyển (hủy, xác nhận thủ công...)']
  changed_at timestamp [not null, default: `now()`]
  changed_by uuid [note: 'UUID user/admin hoặc system']

  Note: '''
  Lịch sử chuyển trạng thái đơn (quyết định D3).
  Phục vụ audit, debug dispute, timeline admin.
  '''
}


// =============================================================================
// SCHEMA: cards — Card Creation (Thiệp tùy chỉnh | EPIC 5, 7) — ENTITY TRUNG TÂM
// =============================================================================

Table cards.cards {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > auth.users.id, note: 'Chủ thiệp']
  template_id uuid [not null, ref: > catalog.templates.id, note: 'Mẫu gốc']
  order_item_id uuid [ref: > commerce.order_items.id, note: 'Dòng đơn đã thanh toán (nullable nếu tạo thủ công)']
  event_name varchar(200) [note: 'Tên sự kiện, VD: Đám cưới An & Bình']
  slug varchar(200) [note: 'Tự sinh từ event_name, không dấu, dùng trong URL']
  guest_link_id varchar(10) [unique, note: 'nanoid 10 ký tự — phần cuối URL khách (D4)']
  status cards.card_status [not null, default: 'draft']
  published_at timestamp [note: 'Thời điểm xuất bản']
  expires_at timestamp [note: 'Ngày hết hạn hosting — scheduler chuyển expired']
  music_id uuid [ref: > catalog.music_library.id, note: 'Nhạc nền đã chọn']
  enable_rsvp boolean [default: true, note: 'Bật form RSVP cho khách']
  enable_wishes boolean [default: true, note: 'Bật lời chúc cho khách']
  enable_bank_info boolean [default: false, note: 'Hiển thị TK ngân hàng mừng cưới']
  og_title varchar(200) [note: 'Open Graph — tiêu đề khi share']
  og_description text [note: 'Open Graph — mô tả']
  og_image_url text [note: 'Open Graph — ảnh preview']
  settings jsonb [default: '{}', note: 'Cấu hình thiệp mở rộng']
  view_count bigint [default: 0, note: 'Đếm view (có thể đồng bộ analytics)']
  deleted_at timestamp [note: 'Soft delete']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  updated_by uuid

  Note: '''
  [AR] Thiệp số — Aggregate Root chính của hệ thống (Card Creation).
  URL công khai: /thiep/{slug}/{owner_short_id}/{guest_link_id}
  Quan hệ: card_fields, card_media, bank_accounts, rsvps, wishes, analytics.
  Chỉ published mới track analytics (ANA-01).
  '''
}

Table cards.card_fields {
  id uuid [pk, default: `gen_random_uuid()`]
  card_id uuid [not null, ref: > cards.cards.id, note: 'FK thiệp']
  template_field_id uuid [not null, ref: > catalog.template_fields.id, note: 'FK định nghĩa trường mẫu']
  field_value text [note: 'Giá trị user nhập: tên, ngày, lời nhắn...']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (card_id, template_field_id) [unique, note: 'Mỗi trường chỉ 1 giá trị trên 1 thiệp']
  }

  Note: '''
  [E] Nội dung trường tùy chỉnh — thuộc Card Aggregate.
  Map template_fields → giá trị thực tế trên thiệp đã tạo.
  '''
}

Table cards.card_media {
  id uuid [pk, default: `gen_random_uuid()`]
  card_id uuid [not null, ref: > cards.cards.id, note: 'FK thiệp']
  template_field_id uuid [ref: > catalog.template_fields.id, note: 'Trường ảnh tương ứng (nullable)']
  file_url text [not null, note: 'URL file trên S3']
  file_type cards.media_type [not null, note: 'image | music']
  file_size bigint [note: 'Dung lượng bytes, max 10MB (CRD-07)']
  original_name varchar(255) [note: 'Tên file gốc khi upload']
  metadata jsonb [default: '{}', note: 'Crop, width, height']
  created_at timestamp [not null, default: `now()`]

  Note: '''
  [E] File media của thiệp (ảnh, nhạc upload) — thuộc Card Aggregate.
  Tối đa 10MB/file (CRD-07). Liên kết trường image trên template.
  '''
}

Table cards.bank_accounts {
  id uuid [pk, default: `gen_random_uuid()`]
  card_id uuid [not null, ref: > cards.cards.id, note: 'FK thiệp']
  bank_name varchar(100) [not null, note: 'Tên ngân hàng']
  account_number varchar(30) [not null, note: 'Số tài khoản']
  account_holder varchar(100) [not null, note: 'Chủ tài khoản']
  label varchar(50) [note: 'Nhãn: bride, groom hoặc tùy chỉnh']
  display_order integer [default: 0, note: 'Thứ tự hiển thị trên thiệp']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Note: '''
  [E] Tài khoản ngân hàng mừng cưới — thuộc Card Aggregate.
  Tối đa 4 TK/thiệp. Chỉ hiện khi enable_bank_info=true (CRD-13).
  '''
}

// =============================================================================
// SCHEMA: engagement — RSVP & Lời chúc (Khách không cần đăng nhập | EPIC 8)
// =============================================================================

Table engagement.rsvps {
  id uuid [pk, default: `gen_random_uuid()`]
  card_id uuid [not null, ref: > cards.cards.id, note: 'Thiệp nhận RSVP']
  guest_name varchar(100) [not null, note: 'Tên khách mời']
  attending boolean [not null, note: 'true = tham dự, false = từ chối']
  guest_count integer [default: 1, note: 'Số người đi cùng']
  note text [note: 'Ghi chú thêm từ khách']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Note: '''
  [AR] Xác nhận tham dự (RSVP) — không cần auth (ENG-01).
  Khách có thể cập nhật nếu khớp guest_name (ENG-02).
  '''
}

Table engagement.wishes {
  id uuid [pk, default: `gen_random_uuid()`]
  card_id uuid [not null, ref: > cards.cards.id, note: 'Thiệp nhận lời chúc']
  sender_name varchar(100) [not null, note: 'Tên người gửi']
  content text [not null, note: 'Nội dung, max 500 ký tự (validate app)']
  is_visible boolean [default: true, note: 'Chủ thiệp ẩn/hiện lời chúc']
  created_at timestamp [not null, default: `now()`]

  Note: '''
  [AR] Lời chúc — không cần auth (ENG-05).
  Hiển thị public: is_visible=true, sắp xếp created_at DESC.
  '''
}

// =============================================================================
// SCHEMA: analytics — Thống kê lượt xem thiệp (EPIC 9) — Tách raw + daily (D5)
// =============================================================================

Table analytics.card_analytics_raw {
  id uuid [pk, default: `gen_random_uuid()`]
  card_id uuid [not null, ref: > cards.cards.id, note: 'Thiệp được xem']
  viewed_at timestamp [not null, default: `now()`, note: 'Thời điểm xem']
  device_type analytics.device_type [note: 'mobile | tablet | desktop']
  os varchar(30) [note: 'Hệ điều hành']
  source analytics.traffic_source [note: 'Nguồn: zalo, facebook, direct...']
  ip_hash varchar(64) [note: 'SHA-256 IP — đếm unique, không lưu IP thô']
  user_agent text [note: 'User-Agent trình duyệt']
  extra jsonb [default: '{}', note: 'UTM, referrer chi tiết']

  Note: '''
  Sự kiện xem trang thô — 1 row = 1 lượt xem.
  Chỉ track thiệp published (ANA-01). Loại view của chủ thiệp (ANA-03).
  Job định kỳ aggregate → card_analytics_daily.
  '''
}

Table analytics.card_analytics_daily {
  id uuid [pk, default: `gen_random_uuid()`]
  card_id uuid [not null, ref: > cards.cards.id, note: 'Thiệp']
  date date [not null, note: 'Ngày tổng hợp']
  total_views bigint [not null, default: 0, note: 'Tổng lượt xem trong ngày']
  unique_views bigint [not null, default: 0, note: 'Lượt xem unique (theo ip_hash)']
  mobile_views bigint [default: 0]
  tablet_views bigint [default: 0]
  desktop_views bigint [default: 0]
  source_zalo bigint [default: 0]
  source_facebook bigint [default: 0]
  source_messenger bigint [default: 0]
  source_sms bigint [default: 0]
  source_direct bigint [default: 0]
  source_other bigint [default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (card_id, date) [unique, note: '1 dòng tổng hợp / thiệp / ngày']
  }

  Note: '''
  Tổng hợp theo ngày — phục vụ dashboard (performance).
  Sinh từ card_analytics_raw bởi scheduled job.
  '''
}

// =============================================================================
// SCHEMA: marketing — Newsletter & B2B (EPIC 10)
// =============================================================================

Table marketing.newsletter_subscribers {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(320) [unique, not null, note: 'Email đăng ký nhận tin']
  confirmed boolean [default: false, note: 'Double opt-in — phải xác nhận']
  confirm_token varchar(255) [note: 'Token xác nhận email']
  unsubscribed boolean [default: false, note: 'Đã hủy đăng ký']
  created_at timestamp [not null, default: `now()`]

  Note: '''
  Đăng ký newsletter. Phải confirmed=true mới được gửi email marketing.
  '''
}

Table marketing.b2b_contacts {
  id uuid [pk, default: `gen_random_uuid()`]
  company_name varchar(200) [not null, note: 'Tên công ty']
  contact_name varchar(100) [not null, note: 'Người liên hệ']
  email varchar(320) [not null, note: 'Email liên hệ']
  phone varchar(15) [note: 'SĐT (tùy chọn)']
  message text [note: 'Nội dung form inquiry']
  status marketing.contact_status [default: 'new', note: 'new | contacted | closed']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  updated_by uuid [note: 'Admin xử lý lead']

  Note: '''
  Form liên hệ B2B / doanh nghiệp. Admin cập nhật status qua panel.
  '''
}

// =============================================================================
// SCHEMA: admin — Audit trail quản trị (EPIC 12)
// =============================================================================

Table admin.audit_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  actor_id uuid [not null, ref: > auth.users.id, note: 'Admin thực hiện hành động']
  action admin.audit_action [not null, note: 'Loại hành động']
  entity_type varchar(50) [not null, note: 'Loại đối tượng: template, order, user...']
  entity_id uuid [not null, note: 'ID bản ghi bị tác động']
  old_value jsonb [note: 'Trạng thái trước (update/delete)']
  new_value jsonb [note: 'Trạng thái sau (create/update)']
  reason text [note: 'Bắt buộc với block_user, hủy đơn']
  ip_address varchar(45) [note: 'IPv4 hoặc IPv6']
  created_at timestamp [not null, default: `now()`]

  Note: '''
  Nhật ký hành động admin (ADM-05). Không soft delete — append-only.
  Tra cứu theo actor_id, entity_type+entity_id, created_at.
  '''
}

// =============================================================================
// QUAN HỆ FK (tóm tắt)
// =============================================================================
// auth.users ──< commerce.cart_items, commerce.orders, cards.cards
// catalog.templates ──< catalog.template_fields, commerce.cart_items, commerce.order_items, cards.cards
// commerce.orders ──< commerce.order_items ──? cards.cards (order_item_id)
// commerce.hosting_plans ──< commerce.order_items
// commerce.orders ──< commerce.order_status_history
// cards.cards ──< cards.card_fields, card_media, bank_accounts, engagement.*, analytics.*
// catalog.template_fields ──< cards.card_fields, cards.card_media
// catalog.music_library ──< cards.cards (music_id)
// auth.users ──< admin.audit_logs (actor_id)

// =============================================================================
// INDEXES (Tối ưu hiệu năng — xem db-decisions.md §4)
// =============================================================================

// -- auth.users
// idx_users_email: already UNIQUE
// idx_users_phone: already UNIQUE
// idx_users_status: lọc user theo trạng thái (admin)
// idx_users_auth_provider: tra cứu OAuth

// -- catalog.templates
// idx_templates_slug: already UNIQUE
// idx_templates_status_event_type: lọc catalog
// idx_templates_is_featured: homepage featured (partial)
// idx_templates_is_trending: homepage trending (partial)
// idx_templates_color_tags: GIN cho JSONB contains

// -- catalog.template_fields
// idx_template_fields_template_id: load fields theo template

// -- commerce.orders
// idx_orders_order_code: already UNIQUE
// idx_orders_user_id: danh sách đơn của user
// idx_orders_status: lọc admin
// idx_orders_created_at: query theo khoảng thời gian

// -- commerce.order_status_history
// idx_order_status_history_order_id: timeline đơn

// -- cards.cards
// idx_cards_user_id: danh sách thiệp của user
// idx_cards_guest_link_id: already UNIQUE — resolve URL công khai
// idx_cards_slug_user_id: resolve URL
// idx_cards_status: lọc
// idx_cards_expires_at: scheduler hết hạn hosting (partial published)

// -- cards.card_fields / card_media
// idx_card_fields_card_id, idx_card_media_card_id: load dữ liệu thiệp

// -- engagement.rsvps / wishes
// idx_rsvps_card_id, idx_rsvps_card_id_guest_name: upsert RSVP
// idx_wishes_card_id, idx_wishes_card_id_is_visible: hiển thị lời chúc

// -- analytics
// idx_analytics_raw_card_id_viewed_at: dashboard
// idx_analytics_daily_card_id_date: already UNIQUE

