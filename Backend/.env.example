# ============ Database ============
POSTGRES_DB=lovecards
POSTGRES_USER=lovecards
POSTGRES_PASSWORD=lovecards_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============ Redis ============
REDIS_HOST=localhost
REDIS_PORT=6379

# ============ RabbitMQ ============
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ============ MinIO (S3-compatible) ============
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=lovecards
MINIO_SECRET_KEY=lovecards_dev
MINIO_BUCKET=lovecards-bucket
MINIO_PUBLIC_URL=http://localhost:9000/lovecards-bucket

# ============ AWS S3 (production — uncomment khi deploy) ============
# S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
# S3_ACCESS_KEY=your-aws-access-key
# S3_SECRET_KEY=your-aws-secret-key
# S3_BUCKET=lovecards-production
# S3_REGION=ap-southeast-1
# S3_PUBLIC_URL=https://cdn.lovecards.vn

# ============ Eureka ============
EUREKA_URL=http://localhost:8761/eureka/

# ============ Config Server ============
CONFIG_SERVER_URL=http://localhost:8888

# ============ JWT (Phase 5) ============
# JWT_SECRET=your-jwt-secret-key-min-32-chars
# JWT_ACCESS_EXPIRATION=900000
# JWT_REFRESH_EXPIRATION=604800000

# ============ OAuth2 (Phase 5) ============
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# FACEBOOK_CLIENT_ID=your-facebook-client-id
# FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# ============ Email / SMTP (Phase 5) ============
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password


# ============ API Gateway ============
# Mac dinh 8080. Doi sang 8090 neu port 8080 bi chiem boi phan mem khac.
API_GATEWAY_PORT=8080
API_GATEWAY_URL=http://localhost:8080

# ============ Swagger ============
SWAGGER_ENABLED=true
